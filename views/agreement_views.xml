<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Payment schedule template -->
    <record id="view_otm_payment_schedule_form" model="ir.ui.view">
        <field name="name">otm.payment.schedule.form</field>
        <field name="model">otm.payment.schedule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="is_default"/>
                            <field name="active"/>
                        </group>
                        <group><field name="total_percentage"/></group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="percentage" sum="Total"/>
                            <field name="trigger"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_otm_payment_schedule_list" model="ir.ui.view">
        <field name="name">otm.payment.schedule.list</field>
        <field name="model">otm.payment.schedule</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="total_percentage"/>
                <field name="is_default"/>
            </list>
        </field>
    </record>
    <record id="action_otm_payment_schedule" model="ir.actions.act_window">
        <field name="name">Payment Schedules</field>
        <field name="res_model">otm.payment.schedule</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Agreement -->
    <record id="view_otm_agreement_list" model="ir.ui.view">
        <field name="name">otm.customer.agreement.list</field>
        <field name="model">otm.customer.agreement</field>
        <field name="arch" type="xml">
            <list decoration-muted="status == 'cancelled'" decoration-success="status == 'completed'">
                <field name="agreement_number"/>
                <field name="customer_id"/>
                <field name="deal_id"/>
                <field name="sales_team_id"/>
                <field name="final_amount"/>
                <field name="agreement_date"/>
                <field name="status" widget="badge"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="view_otm_agreement_form" model="ir.ui.view">
        <field name="name">otm.customer.agreement.form</field>
        <field name="model">otm.customer.agreement</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_generate" type="object" string="Generate" class="btn-primary"
                            invisible="status != 'draft'"/>
                    <button name="action_print" type="object" string="Print PDF"
                            invisible="status in ('draft', 'cancelled')"/>
                    <button name="action_send" type="object" string="Mark as Sent" class="btn-primary"
                            invisible="status != 'generated'"/>
                    <button name="action_accept" type="object" string="Customer Accepted" class="btn-primary"
                            invisible="status != 'sent'"/>
                    <button name="action_sign" type="object" string="Record Signature" class="btn-primary"
                            invisible="status != 'customer_accepted'"/>
                    <button name="action_complete" type="object" string="Complete Agreement" class="btn-primary"
                            groups="sales_project_lifecycle.group_sales_head"
                            invisible="status != 'signed'"/>
                    <button name="action_ask_reason" type="object" string="Cancel"
                            context="{'otm_reason_method': 'action_cancel'}"
                            groups="sales_project_lifecycle.group_sales_head"
                            invisible="status in ('completed', 'cancelled')"/>
                    <field name="status" widget="statusbar" options="{'clickable': False}"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="agreement_number"/></h1></div>
                    <group>
                        <group>
                            <field name="customer_id"/>
                            <field name="deal_id"/>
                            <field name="lead_id"/>
                            <field name="estimate_id"/>
                        </group>
                        <group>
                            <field name="sales_team_id"/>
                            <field name="sales_head_id"/>
                            <field name="salesperson_id"/>
                            <field name="payment_schedule_id" readonly="status != 'draft'"/>
                            <field name="timeline_days" readonly="status != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Content" name="content">
                            <group>
                                <field name="scope" readonly="status != 'draft'"/>
                                <field name="deliverables" readonly="status != 'draft'"/>
                                <field name="approved_services"/>
                                <field name="approved_customizations"/>
                                <field name="final_amount"/>
                                <field name="terms" readonly="status != 'draft'"/>
                            </group>
                        </page>
                        <page string="Payments" name="payments">
                            <field name="payment_ids" readonly="1">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="percentage"/>
                                    <field name="trigger"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="due_date"/>
                                    <field name="status" widget="badge"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Acceptance &amp; Signature" name="signature">
                            <group>
                                <group>
                                    <field name="agreement_date"/>
                                    <field name="sent_date"/>
                                    <field name="accepted_date"/>
                                    <field name="completed_date"/>
                                </group>
                                <group>
                                    <field name="customer_acceptance"
                                           readonly="status not in ('sent', 'customer_accepted')"/>
                                    <field name="signed_date" readonly="status != 'customer_accepted'"/>
                                    <field name="signed_document" filename="signed_filename"
                                           readonly="status != 'customer_accepted'"/>
                                    <field name="signed_filename" invisible="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Notes" name="notes"><field name="notes"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_otm_agreement_search" model="ir.ui.view">
        <field name="name">otm.customer.agreement.search</field>
        <field name="model">otm.customer.agreement</field>
        <field name="arch" type="xml">
            <search>
                <field name="agreement_number"/>
                <field name="customer_id"/>
                <field name="deal_id"/>
                <group>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_otm_agreement" model="ir.actions.act_window">
        <field name="name">Agreements</field>
        <field name="res_model">otm.customer.agreement</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Payments (finance) -->
    <record id="view_otm_deal_payment_list" model="ir.ui.view">
        <field name="name">otm.deal.payment.list</field>
        <field name="model">otm.deal.payment</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" decoration-success="status == 'received'" decoration-muted="status == 'cancelled'" decoration-warning="status in ('due','requested')">
                <field name="deal_id"/>
                <field name="customer_id"/>
                <field name="name"/>
                <field name="percentage"/>
                <field name="amount" sum="Total"/>
                <field name="due_date"/>
                <field name="paid_date"/>
                <field name="status" widget="badge"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="view_otm_deal_payment_form" model="ir.ui.view">
        <field name="name">otm.deal.payment.form</field>
        <field name="model">otm.deal.payment</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <button name="action_request" type="object" string="Request Payment"
                            invisible="status != 'due'"/>
                    <button name="action_confirm" type="object" string="Confirm Payment Received" class="btn-primary"
                            groups="sales_project_lifecycle.group_finance"
                            invisible="status not in ('due', 'requested')"/>
                    <button name="action_ask_reason" type="object" string="Cancel"
                            context="{'otm_reason_method': 'action_cancel'}"
                            groups="sales_project_lifecycle.group_finance_manager"
                            invisible="status not in ('pending', 'due', 'requested')"/>
                    <field name="status" widget="statusbar" options="{'clickable': False}"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="deal_id"/>
                            <field name="agreement_id"/>
                            <field name="customer_id"/>
                            <field name="trigger"/>
                            <field name="percentage"/>
                            <field name="amount"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="due_date"/>
                            <field name="paid_date" readonly="status not in ('due', 'requested')"/>
                            <field name="payment_method" readonly="status not in ('due', 'requested')"/>
                            <field name="payment_reference" readonly="status not in ('due', 'requested')"/>
                            <field name="proof" filename="proof_filename" readonly="status not in ('due', 'requested')"/>
                            <field name="proof_filename" invisible="1"/>
                            <field name="confirmed_by_id"/>
                            <field name="confirmed_date"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notes"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_otm_deal_payment" model="ir.actions.act_window">
        <field name="name">Payments</field>
        <field name="res_model">otm.deal.payment</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>
    <record id="view_otm_deal_payment_search" model="ir.ui.view">
        <field name="name">otm.deal.payment.search</field>
        <field name="model">otm.deal.payment</field>
        <field name="arch" type="xml">
            <search>
                <field name="deal_id"/>
                <field name="customer_id"/>
                <filter name="open" string="To Collect" domain="[('status','in',('due','requested'))]"/>
                <filter name="received" string="Received" domain="[('status','=','received')]"/>
                <group>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
