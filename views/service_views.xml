<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_otm_service_list" model="ir.ui.view">
        <field name="name">otm.service.list</field>
        <field name="model">otm.service</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="service_type"/>
                <field name="base_amount"/>
                <field name="recurring" optional="show"/>
                <field name="recurring_period" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_otm_service_form" model="ir.ui.view">
        <field name="name">otm.service.form</field>
        <field name="model">otm.service</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Odoo CRM"/></h1>
                    </div>
                    <group name="main">
                        <group name="left">
                            <field name="code"/>
                            <field name="service_type"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="base_amount"/>
                        </group>
                        <group name="right">
                            <field name="recurring"/>
                            <field name="recurring_period" invisible="not recurring" required="recurring"/>
                            <field name="default_duration"/>
                            <field name="default_payment_terms"/>
                            <field name="commission_enabled"/>
                            <field name="commission_rule_id" invisible="not commission_enabled"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="page_description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_otm_service_search" model="ir.ui.view">
        <field name="name">otm.service.search</field>
        <field name="model">otm.service</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter name="recurring" string="Recurring" domain="[('recurring', '=', True)]"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <separator/>
                <group>
                    <filter name="group_type" string="Type" context="{'group_by': 'service_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_otm_service" model="ir.actions.act_window">
        <field name="name">Services / Modules</field>
        <field name="res_model">otm.service</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Lead source -->
    <record id="view_otm_lead_source_list" model="ir.ui.view">
        <field name="name">otm.lead.source.list</field>
        <field name="model">otm.lead.source</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_otm_lead_source" model="ir.actions.act_window">
        <field name="name">Lead Sources</field>
        <field name="res_model">otm.lead.source</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
