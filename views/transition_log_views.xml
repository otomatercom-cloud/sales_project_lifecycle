<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_otm_transition_log_list" model="ir.ui.view">
        <field name="name">otm.transition.log.list</field>
        <field name="model">otm.transition.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="record_name"/>
                <field name="action"/>
                <field name="from_state"/>
                <field name="to_state"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="reason" optional="show"/>
                <field name="sales_team_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_otm_transition_log_form" model="ir.ui.view">
        <field name="name">otm.transition.log.form</field>
        <field name="model">otm.transition.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="record_name"/>
                            <field name="res_model"/>
                            <field name="action"/>
                            <field name="from_state"/>
                            <field name="to_state"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="date"/>
                            <field name="sales_team_id"/>
                        </group>
                    </group>
                    <field name="reason"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_otm_transition_log_search" model="ir.ui.view">
        <field name="name">otm.transition.log.search</field>
        <field name="model">otm.transition.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="record_name"/>
                <field name="user_id"/>
                <field name="action"/>
                <separator/>
                <group>
                    <filter name="group_model" string="Model" context="{'group_by': 'res_model'}"/>
                    <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_otm_transition_log" model="ir.actions.act_window">
        <field name="name">Transition History</field>
        <field name="res_model">otm.transition.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
