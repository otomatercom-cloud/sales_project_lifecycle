<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Commission rule -->
    <record id="view_otm_commission_rule_list" model="ir.ui.view">
        <field name="name">otm.commission.rule.list</field>
        <field name="model">otm.commission.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="trigger"/>
                <field name="percentage"/>
                <field name="max_amount"/>
                <field name="approval_required"/>
                <field name="is_default"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="view_otm_commission_rule_form" model="ir.ui.view">
        <field name="name">otm.commission.rule.form</field>
        <field name="model">otm.commission.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="trigger"/>
                            <field name="percentage"/>
                            <field name="max_amount"/>
                        </group>
                        <group>
                            <field name="approval_required"/>
                            <field name="is_default"/>
                            <field name="active"/>
                            <field name="company_id" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_otm_commission_rule" model="ir.actions.act_window">
        <field name="name">Commission Rules</field>
        <field name="res_model">otm.commission.rule</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Commission -->
    <record id="view_otm_commission_list" model="ir.ui.view">
        <field name="name">otm.sales.commission.list</field>
        <field name="model">otm.sales.commission</field>
        <field name="arch" type="xml">
            <list decoration-muted="status in ('cancelled','reversed')" decoration-success="status == 'paid'">
                <field name="name"/>
                <field name="deal_id"/>
                <field name="sales_head_id"/>
                <field name="service_id"/>
                <field name="base_amount"/>
                <field name="additional_amount"/>
                <field name="commission_amount" sum="Total"/>
                <field name="status" widget="badge"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="view_otm_commission_form" model="ir.ui.view">
        <field name="name">otm.sales.commission.form</field>
        <field name="model">otm.sales.commission</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <button name="action_ask_reason" type="object" string="Mark Earned"
                            context="{'otm_reason_method': 'action_earn'}"
                            groups="sales_project_lifecycle.group_finance_manager"
                            invisible="status != 'pending'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            groups="sales_project_lifecycle.group_finance_manager"
                            invisible="status != 'earned'"/>
                    <button name="action_pay" type="object" string="Pay Out" class="btn-primary"
                            groups="sales_project_lifecycle.group_finance_manager"
                            invisible="status != 'approved'"/>
                    <button name="action_ask_reason" type="object" string="Cancel"
                            context="{'otm_reason_method': 'action_cancel'}"
                            groups="sales_project_lifecycle.group_finance_manager"
                            invisible="status not in ('pending','earned')"/>
                    <button name="action_ask_reason" type="object" string="Reverse"
                            context="{'otm_reason_method': 'action_reverse'}"
                            groups="sales_project_lifecycle.group_finance_manager"
                            invisible="status not in ('approved','paid')"/>
                    <field name="status" widget="statusbar" options="{'clickable': False}"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="deal_id"/>
                            <field name="lead_id"/>
                            <field name="customer_id"/>
                            <field name="service_id"/>
                            <field name="sales_head_id"/>
                            <field name="sales_team_id"/>
                        </group>
                        <group>
                            <field name="base_amount"/>
                            <field name="additional_amount"/>
                            <field name="additional_percentage"/>
                            <field name="commission_amount"/>
                            <field name="commission_percentage"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Policy">
                        <group>
                            <field name="rule_id"/>
                            <field name="trigger"/>
                            <field name="approval_required"/>
                        </group>
                        <group>
                            <field name="earned_date"/>
                            <field name="approved_date"/>
                            <field name="paid_date"/>
                        </group>
                    </group>
                    <group string="Notes"><field name="notes" nolabel="1"/></group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_otm_commission_search" model="ir.ui.view">
        <field name="name">otm.sales.commission.search</field>
        <field name="model">otm.sales.commission</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="deal_id"/>
                <field name="sales_head_id"/>
                <filter name="pending" string="Pending" domain="[('status','=','pending')]"/>
                <filter name="to_approve" string="To Approve" domain="[('status','=','earned')]"/>
                <filter name="to_pay" string="To Pay" domain="[('status','=','approved')]"/>
                <group>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_head" string="Sales Head" context="{'group_by': 'sales_head_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_otm_commission" model="ir.actions.act_window">
        <field name="name">Commissions</field>
        <field name="res_model">otm.sales.commission</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Wallet -->
    <record id="view_otm_wallet_list" model="ir.ui.view">
        <field name="name">otm.sales.wallet.list</field>
        <field name="model">otm.sales.wallet</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="sales_head_id"/>
                <field name="total_credited"/>
                <field name="total_paid"/>
                <field name="total_reversed"/>
                <field name="balance" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="view_otm_wallet_form" model="ir.ui.view">
        <field name="name">otm.sales.wallet.form</field>
        <field name="model">otm.sales.wallet</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" edit="0">
                <sheet>
                    <div class="oe_title"><h1><field name="sales_head_id"/></h1></div>
                    <group>
                        <group>
                            <field name="total_credited"/>
                            <field name="total_paid"/>
                            <field name="total_reversed"/>
                        </group>
                        <group>
                            <field name="balance"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="transaction_ids">
                        <list>
                            <field name="date"/>
                            <field name="transaction_type"/>
                            <field name="commission_id"/>
                            <field name="amount"/>
                            <field name="notes"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_otm_wallet" model="ir.actions.act_window">
        <field name="name">Wallets</field>
        <field name="res_model">otm.sales.wallet</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Wallet ledger -->
    <record id="view_otm_wallet_txn_list" model="ir.ui.view">
        <field name="name">otm.sales.wallet.transaction.list</field>
        <field name="model">otm.sales.wallet.transaction</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" edit="0">
                <field name="date"/>
                <field name="sales_head_id"/>
                <field name="transaction_type"/>
                <field name="commission_id"/>
                <field name="lead_id"/>
                <field name="amount"/>
                <field name="signed_amount" sum="Net"/>
                <field name="notes"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="view_otm_wallet_txn_form" model="ir.ui.view">
        <field name="name">otm.sales.wallet.transaction.form</field>
        <field name="model">otm.sales.wallet.transaction</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="wallet_id"/>
                            <field name="transaction_type"/>
                            <field name="amount"/>
                            <field name="signed_amount"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="commission_id"/>
                            <field name="lead_id"/>
                            <field name="customer_id"/>
                            <field name="user_id"/>
                        </group>
                    </group>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_otm_wallet_txn" model="ir.actions.act_window">
        <field name="name">Wallet Transactions</field>
        <field name="res_model">otm.sales.wallet.transaction</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
