<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_otm_sales_team_list" model="ir.ui.view">
        <field name="name">otm.sales.team.list</field>
        <field name="model">otm.sales.team</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="head_id"/>
                <field name="member_ids" widget="many2many_tags"/>
                <field name="target_amount" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_otm_sales_team_form" model="ir.ui.view">
        <field name="name">otm.sales.team.form</field>
        <field name="model">otm.sales.team</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_leads" type="object" class="oe_stat_button" icon="fa-bullseye">
                            <field name="lead_count" widget="statinfo" string="Leads"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Odoo Solutions"/></h1>
                    </div>
                    <group name="main">
                        <group name="left">
                            <field name="code"/>
                            <field name="head_id"/>
                            <field name="target_amount"/>
                        </group>
                        <group name="right">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Sales Executives" name="page_members">
                            <field name="member_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Description" name="page_description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_otm_sales_team_search" model="ir.ui.view">
        <field name="name">otm.sales.team.search</field>
        <field name="model">otm.sales.team</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="head_id"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_otm_sales_team" model="ir.actions.act_window">
        <field name="name">Sales Teams</field>
        <field name="res_model">otm.sales.team</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
