<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_otm_review_list" model="ir.ui.view">
        <field name="name">otm.customer.review.list</field>
        <field name="model">otm.customer.review</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="customer_id"/><field name="project_id"/>
                  <field name="average_rating"/><field name="recommendation"/>
                  <field name="published"/><field name="status" widget="badge"/></list>
        </field>
    </record>
    <record id="view_otm_review_form" model="ir.ui.view">
        <field name="name">otm.customer.review.form</field>
        <field name="model">otm.customer.review</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <button name="action_submit" type="object" string="Record Review" class="btn-primary" invisible="status != 'requested'"/>
                    <button name="action_publish" type="object" string="Publish"
                            groups="sales_project_lifecycle.group_sales_head"
                            invisible="status != 'submitted' or published or not testimonial_permission"/>
                    <button name="action_unpublish" type="object" string="Unpublish"
                            groups="sales_project_lifecycle.group_sales_head" invisible="not published"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group><field name="customer_id"/><field name="project_id"/><field name="requested_date"/>
                               <field name="submitted_date"/><field name="submitted_by_id"/></group>
                        <group>
                            <field name="rating" readonly="status == 'submitted'" widget="radio"/>
                            <field name="service_rating" readonly="status == 'submitted'"/>
                            <field name="quality_rating" readonly="status == 'submitted'"/>
                            <field name="support_rating" readonly="status == 'submitted'"/>
                            <field name="average_rating"/>
                            <field name="recommendation" readonly="status == 'submitted'"/>
                            <field name="testimonial_permission" readonly="status == 'submitted'"/>
                            <field name="published"/>
                        </group>
                    </group>
                    <group string="Comments"><field name="comments" nolabel="1" readonly="status == 'submitted'"/></group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_otm_review" model="ir.actions.act_window">
        <field name="name">Customer Reviews</field><field name="res_model">otm.customer.review</field><field name="view_mode">list,form</field>
    </record>
</odoo>
