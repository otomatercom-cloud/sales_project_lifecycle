<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_otm_lead_lost_wizard_form" model="ir.ui.view">
        <field name="name">otm.lead.lost.wizard.form</field>
        <field name="model">otm.lead.lost.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="lead_id" invisible="1"/>
                    <field name="reason"/>
                    <field name="description"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Mark as Lost" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
