<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_otm_reason_wizard_form" model="ir.ui.view">
        <field name="name">otm.reason.wizard.form</field>
        <field name="model">otm.reason.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="res_model" invisible="1"/>
                    <field name="res_id" invisible="1"/>
                    <field name="method" invisible="1"/>
                    <field name="reason" placeholder="Reason / comment"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
