<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_otm_message_template_list" model="ir.ui.view">
        <field name="name">otm.message.template.list</field>
        <field name="model">otm.message.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="channel"/>
                <field name="body"/>
            </list>
        </field>
    </record>
    <record id="view_otm_message_template_form" model="ir.ui.view">
        <field name="name">otm.message.template.form</field>
        <field name="model">otm.message.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="channel"/>
                        <field name="active"/>
                    </group>
                    <field name="body" placeholder="Hi {customer}, ..."/>
                    <div class="text-muted">Placeholders: {customer} {company} {reference} {executive} {service}</div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_otm_message_template" model="ir.actions.act_window">
        <field name="name">Message Templates</field>
        <field name="res_model">otm.message.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
