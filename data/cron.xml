<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_expire_estimates" model="ir.cron">
        <field name="name">Sales Lifecycle: expire outdated estimates</field>
        <field name="model_id" ref="model_otm_estimate"/>
        <field name="state">code</field>
        <field name="code">model._cron_expire_estimates()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
