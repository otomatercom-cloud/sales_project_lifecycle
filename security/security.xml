<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Privileges (one per functional area) -->
    <record id="privilege_sales" model="res.groups.privilege">
        <field name="name">Sales Lifecycle</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>
    <record id="privilege_project" model="res.groups.privilege">
        <field name="name">Project Lifecycle</field>
        <field name="sequence">31</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>
    <record id="privilege_finance" model="res.groups.privilege">
        <field name="name">Lifecycle Finance</field>
        <field name="sequence">32</field>
        <field name="category_id" ref="base.module_category_accounting"/>
    </record>

    <!-- Sales -->
    <record id="group_sales_executive" model="res.groups">
        <field name="name">Sales Executive</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_sales"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_sales_head" model="res.groups">
        <field name="name">Sales Head</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_sales"/>
        <field name="implied_ids" eval="[(4, ref('group_sales_executive'))]"/>
    </record>

    <!-- Project -->
    <record id="group_developer" model="res.groups">
        <field name="name">Developer</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_project"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('project.group_project_user'))]"/>
    </record>
    <record id="group_qc" model="res.groups">
        <field name="name">QC</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_project"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('project.group_project_user'))]"/>
    </record>
    <record id="group_project_head" model="res.groups">
        <field name="name">Project Head</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="privilege_project"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('project.group_project_manager'))]"/>
    </record>

    <!-- Finance -->
    <record id="group_finance" model="res.groups">
        <field name="name">Finance</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_finance"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_finance_manager" model="res.groups">
        <field name="name">Finance Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_finance"/>
        <field name="implied_ids" eval="[(4, ref('group_finance'))]"/>
    </record>

    <!-- Administrator -->
    <record id="group_lifecycle_admin" model="res.groups">
        <field name="name">Lifecycle Administrator</field>
        <field name="sequence">100</field>
        <field name="privilege_id" ref="privilege_sales"/>
        <field name="implied_ids" eval="[(4, ref('group_sales_head')), (4, ref('group_project_head')), (4, ref('group_qc')), (4, ref('group_finance_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- ============================================================
         RECORD RULES
         Written with relational domains on the *current user id* (not on a
         list evaluated from the user), because Odoo caches the evaluated rule
         domain per user: a membership list baked into the domain would go
         stale when a team is edited.
         ============================================================ -->
    <data noupdate="1">
        <!-- Sales Team -->
        <record id="rule_team_executive" model="ir.rule">
            <field name="name">Sales Team: members see their own team</field>
            <field name="model_id" ref="model_otm_sales_team"/>
            <field name="groups" eval="[(4, ref('group_sales_executive'))]"/>
            <field name="domain_force">['|', ('head_id', '=', user.id), ('member_ids', 'in', [user.id])]</field>
        </record>
        <record id="rule_team_admin" model="ir.rule">
            <field name="name">Sales Team: administrator sees all</field>
            <field name="model_id" ref="model_otm_sales_team"/>
            <field name="groups" eval="[(4, ref('group_lifecycle_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Lead -->
        <record id="rule_lead_executive" model="ir.rule">
            <field name="name">Lead: executive sees own leads</field>
            <field name="model_id" ref="model_otm_lead"/>
